{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "irisbeat-delivery",
  "main": "src/notification-delivery.ts",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "queues": {
    "consumers": [{
      "queue": "irisbeat-notifications",
      "max_retries": 10,
    }],
    "producers": [{ "binding": "NOTIFICATION_DLQ", "queue": "irisbeat-notifications-dead-letter" }],
  },
  "durable_objects": {
    "bindings": [{ "name": "NOTIFICATION_RECOVERY", "class_name": "NotificationRecovery" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NotificationRecovery"] }],
  "services": [
    { "binding": "NOTIFICATION_DELIVERY", "service": "irisbeat", "entrypoint": "NotificationDelivery" },
  ],
  "observability": {
    "enabled": true,
    // Automatic fetch spans include webhook URLs, which can contain credentials.
    "traces": { "enabled": false },
  },
}

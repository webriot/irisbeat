{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "irisbeat",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "version_metadata": { "binding": "IRISBEAT_VERSION" },
  "keep_vars": true,
  "analytics_engine_datasets": [
    { "binding": "AVAILABILITY_HISTORY", "dataset": "irisbeat_availability" },
  ],
  "triggers": {
    "crons": ["* * * * *"],
  },
  "queues": {
    "producers": [{ "binding": "NOTIFICATION_QUEUE", "queue": "irisbeat-notifications" }],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MONITORING",
        "class_name": "MonitoringContext",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MonitoringContext"],
    },
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "secrets": {
    "required": ["INSTALLATION_SECRET", "AVAILABILITY_API_TOKEN"],
  },
}

{
  "name": "irisbeat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "types": "wrangler types",
    "check": "npm run types && tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run",
    "pack:engine": "mkdir -p dist && npm pack --pack-destination dist",
    "test:consumer": "node test/consumer.cjs",
    "deploy": "wrangler deploy",
    "release:prepare": "node scripts/release.cjs",
    "test:release": "node test/release.cjs",
    "test:deployment": "node test/deployment.cjs",
    "release:verify": "npm run check && npm test && npm run test:consumer && npm run build && npm run test:release && npm run test:deployment"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@msw/cloudflare": "^0.2.0",
    "msw": "^3.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "docs/hosted-contract.md",
    "docs/maintenance-api.md",
    "docs/history-api.md",
    "docs/install.md",
    "NOTICE"
  ],
  "cloudflare": {
    "bindings": {
      "INSTALLATION_SECRET": {
        "description": "Generate a unique random installation secret (for example, `openssl rand -hex 32`). It protects operator administration and personal Heartbeats. Keep it private."
      }
    }
  }
}
